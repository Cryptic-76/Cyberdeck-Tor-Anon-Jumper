# ==============================================================================
# Cyberdeck Tor Suite - Privoxy Hardened Configuration Template
# ==============================================================================

# --- Netzwerk & Bindings ---
listen-address {privoxy_host}:{privoxy_port}
toggle 1
enable-remote-toggle 0
enable-remote-http-toggle 0
enable-edit-actions 0
enforce-blocks 1
buffer-limit 4096

# --- SOCKS5t Forwarding an Tor (inkl. Remote-DNS-Auflösung) ---
# Das "t" in forward-socks5t erzwingt SOCKS5 mit Remote-DNS (Kein lokales DNS-Leak)
forward-socks5t / {socks_host}:{socks_port} .

# --- Dateisystem (für Fehlerseiten-Templates & CA-Dateien) ---
# Ohne expliziten confdir sucht Privoxy in seinem eingebauten Standardverzeichnis
# und findet die Fehlerseiten-Templates (u.a. 'forwarding-failed') nicht -> im
# Fehlerfall nur kryptische 500-Seite "Could not load template file <name>".
confdir /etc/privoxy

# --- Logging & Traces minimieren ---
logfile {data_directory}/privoxy.log

# --- Privacy & Header Hardening (echte Privoxy-Actions) ---
# WICHTIG: Werte wie 'hide-user-agent', 'crunch-client-header' oder 'hide-referrer' sind
# KEINE gültigen Privoxy-Direktiven – sie wurden davor stillschweigend ignoriert. Die
# Härtung wird real über die separate Actions-Datei user.action angewendet (actionsfile):
# +hide-user-agent, +hide-referer, +hide-from-header, +crunch-client-header,
# +change-x-forwarded-for und +hide-if-modified-since sind dort definiert.
actionsfile {data_directory}/user.action